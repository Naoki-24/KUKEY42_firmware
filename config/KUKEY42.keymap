#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define NUM 1
#define FN_SCROLL 2
#define BT 3

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        paren_left: paren_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT>;
            label = "PAREN_LEFT";
        };

        bracket_left: bracket_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT &kp BSLH &kp LEFT>;
            label = "BRACKET_LEFT";
        };
    };

    behaviors {
        td_henkan: td_henkan {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE_KANA";
            #binding-cells = <0>;
            bindings = <&kp INT2>, <&kp INT4>;

            tapping-term-ms = <400>;
        };

        td_esc_bt: td_esc_bt {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE_ESC_BT";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&sl BT>;

            tapping-term-ms = <400>;
        };

        lt_num_henkan: lt_num_henkan {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_NUM_HENKAN";
            bindings = <&mo>, <&td_henkan>;
            #binding-cells = <1>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        semicolon_colon: semicolon_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMICOLON_COLON";
            #binding-cells = <0>;
            bindings = <&kp QUOTE>, <&kp LS(QUOTE)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        quote_dquote: quote_dquote {
            compatible = "zmk,behavior-mod-morph";
            label = "QUOTE_DQUOTE";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp LS(N7)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        equal_plus: equal_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "EQUAL_PLUS";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp LS(SEMICOLON)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_underscore: minus_underscore {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_UNDERSCORE";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INTERNATIONAL_1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ht_bracket_os: ht_bracket_os {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_BRACKET_OS";
            bindings = <&kp>, <&bracket_left>;
            #binding-cells = <1>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        ht_paren_ctrl: ht_paren_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_PAREN_CTRL";
            bindings = <&kp>, <&paren_left>;
            #binding-cells = <1>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        WheelScroll: WheelScroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "WHEELSCROLL";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp Q                &kp W                &kp E                &kp R                &kp T                                                               &kp Y                &kp U                &kp I                &kp O                &kp P
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp A                &kp S                &kp D                &kp F                &kp G                &kp TAB                   &minus_underscore    &kp H                &kp J                &kp K                &kp L                &quote_dquote
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp Z                &kp X                &kp C                &kp V                &kp B                &td_esc_bt                &kp BACKSPACE        &kp N                &kp M                &kp COMMA            &kp DOT              &kp SLASH
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &ht_paren_ctrl LCTRL &ht_bracket_os LGUI  &kp LEFT_ALT         &kp N0               &lt FN_SCROLL ENTER  &kp LCLK                  &lt_num_henkan NUM   &mt LSHIFT SPACE                                                                    &semicolon_colon
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
            >;

            sensor-bindings = <&WheelScroll SCRL_DOWN SCRL_UP>;
        };

        NUM {
            bindings = <
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp N1               &kp N2               &kp N3               &kp N4               &kp N5                                                              &trans               &trans               &trans               &trans               &kp DEL
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp N6               &kp N7               &kp N8               &kp N9               &kp N0               &equal_plus               &trans               &kp LG(LEFT_ARROW)   &kp LG(DOWN_ARROW)   &kp LG(UP_ARROW)     &kp LG(RIGHT_ARROW)  &kp PAGE_UP
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &trans               &trans               &trans               &trans               &trans               &kp LC(Z)                 &trans               &kp LA(LEFT_ARROW)   &kp LA(RIGHT_ARROW)  &trans               &trans               &kp PAGE_DOWN
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &trans               &trans               &trans               &trans               &trans               &mkp RCLK                 &trans               &trans                                                                              &kp KP_NUMLOCK
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
            >;

            sensor-bindings = <&WheelScroll SCRL_LEFT SCRL_RIGHT>;
        };

        FN_SCROLL {
            bindings = <
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp F1               &kp F2               &kp F3               &kp F4               &kp F5                                                              &kp LS(N1)           &kp LS(N3)           &kp LS(N4)           &kp LS(N5)           &kp LS(N6)
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp F6               &kp F7               &kp F8               &kp F9               &kp F10              &kp F11                   &kp LS(N7)           &kp LEFT_ARROW       &kp DOWN_ARROW       &kp UP_ARROW         &kp RIGHT_ARROW      &kp CARET
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &kp LC(Z)            &kp LC(X)            &kp LC(C)            &kp LC(V)            &trans               &kp F12                   &trans               &trans               &trans               &kp LS(COLON)        &kp LS(INT3)         &kp LS(EQUAL)
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &trans               &trans               &trans               &trans               &trans               &mkp MCLK                 &kp LA(LEFT_ARROW)   &kp LA(RIGHT_ARROW)                                                                 &kp BSLH
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        BT {
            bindings = <
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &trans               &trans               &trans               &trans               &trans                                                              &bt BT_SEL 0         &bt BT_SEL 1         &bt BT_SEL 2         &bt BT_SEL 3         &bt BT_SEL 4
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &trans               &trans               &trans               &trans               &trans               &trans                    &sys_reset           &trans               &trans               &trans               &trans               &trans
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &trans               &kp NUMBER_1         &kp NUMBER_2         &kp NUMBER_3         &trans               &trans                    &bootloader          &trans               &trans               &trans               &trans               &bt BT_CLR
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
    &bootloader          &sys_reset           &trans               &trans               &trans               &trans                    &trans               &trans                                                                             &bt BT_CLR_ALL
// +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+    +--------------------+--------------------+--------------------+--------------------+--------------------+--------------------+
            >;
        };
    };
};
